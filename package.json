{
	"name": "@hikae/jev-algorithms",
	"version": "0.2.0",
	"description": "Runtime-agnostic algorithms built on TypeSafe's Jev structured-evaluation model.",
	"keywords": [
		"jev",
		"typesafe",
		"evaluation",
		"algorithms",
		"sorting",
		"ranking",
		"clustering",
		"matching"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HikaruEgashira/jev-algorithms.git"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs/animations/*.gif"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test",
		"mutation": "npm run build && stryker run",
		"animations": "npm run build && node scripts/render-animations.mjs",
		"experiment": "npm run build && node scripts/experiment-quicksort.mjs",
		"prepublishOnly": "npm test"
	},
	"devDependencies": {
		"@stryker-mutator/core": "^10.0.0",
		"tree-sitter": "^0.25.1",
		"tree-sitter-go": "^0.25.0",
		"tree-sitter-javascript": "^0.25.0",
		"typescript": "^5.6.0"
	},
	"packageManager": "pnpm@11.26.0"
}
